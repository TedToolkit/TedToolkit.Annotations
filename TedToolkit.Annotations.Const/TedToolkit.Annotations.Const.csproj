<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk" />
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk" />
  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>
  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk" />
  <PropertyGroup>
    <Title>Const annotations</Title>
    <Description>Object-graph immutability annotations.</Description>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup><None Include="..\TedToolkit.Annotations.Const.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.Annotations.Const.Analyzer.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" /><None Include="..\TedToolkit.Annotations.Const.CodeFixes\bin\$(Configuration)\netstandard2.0\TedToolkit.Annotations.Const.CodeFixes.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" /></ItemGroup>
  <Target Name="BuildDomainAnalyzer" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'"><MSBuild Projects="..\TedToolkit.Annotations.Const.CodeFixes\TedToolkit.Annotations.Const.CodeFixes.csproj" Targets="Build" Properties="Configuration=$(Configuration)" /></Target>

  <ItemGroup>
    <None Include="../.agents/skills/use-const-annotations/**/*"
          Pack="true" PackagePath="skills/use-const-annotations/" />
  </ItemGroup>
</Project>
